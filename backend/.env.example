# Copy to .env and fill in your values:
#   cp backend/.env.example backend/.env

# ─── API Keys ────────────────────────────────────────────────────────────────

# Anthropic API key — required when LLM_PROVIDER=anthropic
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace token — optional, raises rate limits for model downloads
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# ─── LLM Provider ────────────────────────────────────────────────────────────

# "ollama" (default, local) or "anthropic" (cloud)
LLM_PROVIDER=ollama

# Ollama — only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# ─── RAG ─────────────────────────────────────────────────────────────────────

# Path to the Chroma vector store (relative to backend/ working directory)
# CHROMA_PATH=chroma_db

# Number of chunks passed to the LLM after re-ranking
# Smaller models (4B): 3–4 | Larger models (26B+): 8–10
RAG_TOP_N=5

# Max characters per chunk sent to the LLM (0 = no limit)
# Smaller models (4B): 600–800 | Larger models: 0
RAG_CHUNK_MAX_CHARS=800

# HyDE — generate a hypothetical answer before embedding the query
# Improves recall for vague queries, costs one extra LLM call
HYDE_ENABLED=false

# ─── Chat Memory ─────────────────────────────────────────────────────────────

# Max tokens of chat history sent to the LLM per request
# Smaller models (4B): 1024–2048 | Larger models: 4096–8192
MEMORY_TOKEN_LIMIT=2048

# ─── Server ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:3000

# Default tax year for RAG metadata filtering
# TAX_YEAR=2025
