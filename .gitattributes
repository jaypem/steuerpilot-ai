# =============================================================================
# .gitattributes — normalise line endings and configure diff behaviour
# https://git-scm.com/docs/gitattributes
# =============================================================================

# ---------------------------------------------------------------------------
# Default: normalise all text files to LF in the repository
# ---------------------------------------------------------------------------
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Explicitly text files — always normalise line endings
# ---------------------------------------------------------------------------
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.jsx       text eol=lf
*.tsx       text eol=lf
*.py        text eol=lf
*.go        text eol=lf
*.java      text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf

# ---------------------------------------------------------------------------
# Windows batch files — must keep CRLF
# ---------------------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------------------------------------------------------------------------
# Binary files — do not modify
# ---------------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.whl       binary
*.jar       binary
*.pyc       binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# ---------------------------------------------------------------------------
# Diffs — use human-readable diff drivers where possible
# ---------------------------------------------------------------------------
*.json      diff=json
*.ipynb     diff=ipynb

# ---------------------------------------------------------------------------
# Export-ignore — exclude from `git archive` (e.g., GitHub releases)
# ---------------------------------------------------------------------------
.github              export-ignore
.bitbucket           export-ignore
.editorconfig        export-ignore
.pre-commit-config.yaml export-ignore
tests/               export-ignore
docs/                export-ignore
