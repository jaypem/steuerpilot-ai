# Copy to .env and fill in your values

ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated allowed CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Tax year for RAG metadata filter
# TAX_YEAR=2025

# LLM provider: "anthropic" (default) or "ollama"
# LLM_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# RAG — Chroma vector store path (default: chroma_db relative to backend/)
# CHROMA_PATH=chroma_db

# ContextChatEngine settings
RAG_TOP_N=3               # Chunks ans LLM (default 5)
RAG_CHUNK_MAX_CHARS=800   # Max Zeichen pro Chunk (default 800, 0 = unbegrenzt)
MEMORY_TOKEN_LIMIT=2048   # Chat-Verlauf in Tokens (default 2048)
